<div class="mx-auto max-w-4xl px-6 py-12">
  <div class="mb-8 flex items-center justify-between">
    <a href="/dashboard" class="text-sm text-zinc-500 hover:text-zinc-300">&larr; Dashboard</a>
  </div>

  <div class="mb-12 text-center">
    <h1 class="mb-4 text-4xl font-bold text-zinc-100">🎯 Assessment Complete!</h1>
    <p class="text-lg text-zinc-400">Here's your personalized learning report</p>
  </div>

  <!-- Score Card -->
  <div class="mb-12 rounded-xl border border-zinc-800 bg-zinc-900/30 p-8 text-center">
    <div class="mb-6">
      <span class="text-6xl font-bold text-indigo-400"><%= score %></span>
      <span class="text-2xl text-zinc-400">/5</span>
    </div>
    
    <div class="mb-4">
      <span class="inline-block rounded-full border border-zinc-700 bg-zinc-800 px-4 py-2 text-lg font-semibold text-zinc-100">
        <%= levelBadge %> Level
      </span>
    </div>
    
    <p class="text-zinc-300"><%= assessment.feedback_text %></p>
  </div>

  <!-- Mistake Analysis -->
  <div class="mb-12">
    <h2 class="mb-6 text-2xl font-bold text-zinc-100">🔍 Mistake Analysis</h2>
    
    <% if (analysis && analysis.length > 0) { %>
      <div class="space-y-4">
        <% analysis.forEach((question, index) => { %>
          <div class="rounded-lg border border-zinc-800 bg-zinc-900/20 p-6">
            <div class="mb-3 flex items-start justify-between">
              <h3 class="font-semibold text-zinc-100">Question <%= index + 1 %></h3>
              <% if (question.correct) { %>
                <span class="rounded-full border border-green-900 bg-green-950/30 px-2 py-0.5 text-xs text-green-300">✅ Correct</span>
              <% } else { %>
                <span class="rounded-full border border-red-900 bg-red-950/30 px-2 py-0.5 text-xs text-red-300">❌ Incorrect</span>
              <% } %>
            </div>
            
            <% if (!question.correct) { %>
              <div class="mb-3 rounded-lg border border-red-900 bg-red-950/20 p-3 text-sm">
                <p class="font-medium text-red-300">Correct Answer: <%= question.correct_answer %></p>
                <p class="mt-1 text-red-200"><%= question.explanation %></p>
              </div>
            <% } %>
            
            <p class="text-sm text-zinc-400"><strong>Topic:</strong> <%= question.weak_topic || 'General' %></p>
            <p class="mt-2 text-zinc-300"><%= question.note %></p>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="rounded-lg border border-dashed border-zinc-800 p-8 text-center text-zinc-500">
        No detailed analysis available.
      </div>
    <% } %>
  </div>

  <!-- Personalized Syllabus Preview -->
  <div class="mb-12">
    <h2 class="mb-6 text-2xl font-bold text-zinc-100">📚 Your Personalized Learning Path</h2>
    
    <div class="grid gap-4 md:grid-cols-2">
      <% syllabus.slice(0, 4).forEach((module, index) => { %>
        <div class="rounded-lg border border-zinc-800 bg-zinc-900/20 p-5">
          <div class="mb-2 flex items-center justify-between">
            <h3 class="font-semibold text-zinc-100"><%= module.title %></h3>
            <span class="rounded-full border border-zinc-700 bg-zinc-800 px-2 py-0.5 text-xs text-zinc-400">Module <%= index + 1 %></span>
          </div>
          <p class="mb-3 text-sm text-zinc-400"><%= module.description %></p>
          
          <div class="flex flex-wrap gap-2">
            <% module.topics.slice(0, 3).forEach(topic => { %>
              <span class="rounded border border-zinc-700 bg-zinc-800 px-2 py-0.5 text-xs text-zinc-300"><%= topic %></span>
            <% }) %>
            <% if (module.topics.length > 3) { %>
              <span class="rounded border border-zinc-700 bg-zinc-800 px-2 py-0.5 text-xs text-zinc-300">+<%= module.topics.length - 3 %> more</span>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Call to Action -->
  <div class="text-center">
    <a href="/course/<%= course.id %>" class="inline-block rounded-lg bg-indigo-600 px-8 py-4 text-lg font-semibold text-white transition-colors hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/30">
      🚀 Generate My Personalized Map & Start Learning
    </a>
  </div>
</div>

<style>
  /* Add some subtle animations */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .fade-in {
    animation: fadeIn 0.5s ease-out;
  }
  
  /* Add animation delays for staggered appearance */
  .fade-in-1 { animation-delay: 0.1s; }
  .fade-in-2 { animation-delay: 0.2s; }
  .fade-in-3 { animation-delay: 0.3s; }
  .fade-in-4 { animation-delay: 0.4s; }
</style>

<script>
  // Add fade-in animations on page load
  document.addEventListener('DOMContentLoaded', function() {
    const elements = document.querySelectorAll('div, h1, h2, h3, p, a, span');
    elements.forEach((el, index) => {
      if (el.classList.contains('text-zinc-100') || 
          el.classList.contains('text-zinc-400') || 
          el.classList.contains('text-zinc-300')) {
        el.classList.add('fade-in');
        const delayClass = `fade-in-${(index % 4) + 1}`;
        el.classList.add(delayClass);
      }
    });
  });
</script>
<div class="mx-auto max-w-4xl px-6 py-12 opacity-0 animate-[fadeIn_.45s_ease-out_forwards]">
  <style>
    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
  </style>

  <div class="mb-8">
    <a href="/dashboard" class="text-sm text-zinc-500 hover:text-zinc-300">&larr; Back to Dashboard</a>
    <h1 class="mt-4 text-3xl font-bold text-zinc-100">First Impression Report</h1>
    <p class="mt-2 text-zinc-400">Topic: <span class="font-medium text-zinc-200"><%= subject %></span></p>
  </div>

  <section class="grid gap-6 md:grid-cols-3">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 md:col-span-2">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <div class="text-xs font-semibold tracking-widest text-zinc-400">SCORE</div>
          <div class="mt-2 text-6xl font-black tracking-tight text-zinc-100"><%= scoreOutOf100 %><span class="text-zinc-500">/100</span></div>
          <div class="mt-2 text-sm text-zinc-500">(<%= grading.score %>/5 questions correct)</div>
        </div>

        <div class="flex flex-col items-end gap-2">
          <span class="rounded-full border border-indigo-900 bg-indigo-950/40 px-3 py-1 text-sm font-semibold text-indigo-200">
            <%= levelBadge %>
          </span>
          <span class="text-xs text-zinc-500">Your starting level</span>
        </div>
      </div>

      <% if (grading.feedback_text) { %>
        <div class="mt-6 rounded-xl border border-zinc-800 bg-zinc-950/40 p-4">
          <div class="text-xs font-semibold tracking-widest text-zinc-400">COACHING NOTE</div>
          <div class="mt-2 text-sm text-zinc-200"><%= grading.feedback_text %></div>
        </div>
      <% } %>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <form method="POST" action="/assessment/<%= assessmentId %>/generate-map">
          <button type="submit" class="rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-500/20 transition-all hover:bg-indigo-500 active:scale-95">
            Generate My Personalized Map
          </button>
        </form>

        <a href="/quiz/<%= encodeURIComponent(subject) %>" class="rounded-xl border border-zinc-800 bg-zinc-950/40 px-5 py-3 text-sm font-semibold text-zinc-200 transition-all hover:bg-zinc-900 active:scale-95">
          Retake Assessment
        </a>
      </div>
    </div>

    <div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6">
      <div class="text-xs font-semibold tracking-widest text-zinc-400">WEAK TOPICS</div>
      <div class="mt-3 flex flex-wrap gap-2">
        <% const weak = Array.isArray(grading.weak_topics) ? grading.weak_topics : []; %>
        <% if (weak.length) { %>
          <% weak.slice(0, 8).forEach(t => { %>
            <span class="rounded-full border border-zinc-800 bg-zinc-950/50 px-3 py-1 text-xs text-zinc-300"><%= t %></span>
          <% }) %>
        <% } else { %>
          <div class="text-sm text-zinc-500">No major weak spots detected.</div>
        <% } %>
      </div>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-semibold text-zinc-100">Mistake Analysis</h2>
    <p class="mt-1 text-sm text-zinc-500">Specific misses and what to review next.</p>

    <% const wrong = (analysis || []).filter(a => !a.correct); %>

    <% if (!wrong.length) { %>
      <div class="mt-6 rounded-xl border border-green-900 bg-green-950/20 p-6 text-green-200">
        Perfect score — you’re ready for advanced material. ✅
      </div>
    <% } else { %>
      <div class="mt-6 space-y-4">
        <% wrong.forEach(item => { %>
          <div class="rounded-xl border border-zinc-800 bg-zinc-900/30 p-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="text-xs font-semibold tracking-widest text-zinc-400">QUESTION <%= item.index + 1 %></div>
                <div class="mt-2 text-sm font-medium text-zinc-100"><%= item.question %></div>
              </div>
              <span class="rounded-full border border-red-900 bg-red-950/30 px-3 py-1 text-xs font-semibold text-red-200">Missed</span>
            </div>

            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <div class="rounded-lg border border-zinc-800 bg-zinc-950/40 p-4">
                <div class="text-xs font-semibold text-zinc-400">Your Answer</div>
                <div class="mt-1 text-sm text-zinc-200"><%= item.selected || '—' %></div>
              </div>
              <div class="rounded-lg border border-zinc-800 bg-zinc-950/40 p-4">
                <div class="text-xs font-semibold text-zinc-400">Correct Answer</div>
                <div class="mt-1 text-sm text-green-200"><%= item.correctAnswer || '—' %></div>
              </div>
            </div>

            <% if (item.note) { %>
              <div class="mt-4 rounded-lg border border-zinc-800 bg-zinc-950/40 p-4">
                <div class="text-xs font-semibold text-zinc-400">Why?</div>
                <div class="mt-1 text-sm text-zinc-200"><%= item.note %></div>
              </div>
            <% } %>

            <% if (item.weak_topic) { %>
              <div class="mt-4 text-xs text-zinc-500">Suggested review: <span class="text-zinc-300"><%= item.weak_topic %></span></div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>
